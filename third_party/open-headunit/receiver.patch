+
+/** Tesla Hub diagnostics extension, 2026-10-13. SPDX-License-Identifier: AGPL-3.0-or-later. */
+object TeslaHubProbe {
+    @Volatile private var announcedDpi: Int? = null
+    @Volatile private var announcedFps: Int? = null
+
+    fun recordAnnouncement(dpi: Int, fps: Int) {
+        announcedDpi = dpi
+        announcedFps = fps
+    }
+
+    fun snapshot(component: AppComponent): JSONObject {
+        val transportStarted = component.commManager.isConnected &&
+            component.commManager.connectionState.value is com.andrerinas.openheadunit.connection.CommManager.ConnectionState.TransportStarted
+        val video = component.videoDecoder
+        val hasFrames = transportStarted && video.framesRenderedThisSession > 0
+        val lastFrame = video.diagnosticLastFrameMs
+        return JSONObject().put("probeVersion", 1)
+            .put("transportStarted", transportStarted)
+            .put("framesRendered", if (transportStarted) video.framesRenderedThisSession else 0L)
+            .put("decodedWidth", if (hasFrames) video.videoWidth else JSONObject.NULL)
+            .put("decodedHeight", if (hasFrames) video.videoHeight else JSONObject.NULL)
+            .put("announcedWidth", if (transportStarted) com.andrerinas.openheadunit.utils.HeadUnitScreenConfig.getNegotiatedWidth() else JSONObject.NULL)
+            .put("announcedHeight", if (transportStarted) com.andrerinas.openheadunit.utils.HeadUnitScreenConfig.getNegotiatedHeight() else JSONObject.NULL)
+            .put("announcedDpi", if (transportStarted) announcedDpi ?: JSONObject.NULL else JSONObject.NULL)
+            .put("announcedFps", if (transportStarted) announcedFps ?: JSONObject.NULL else JSONObject.NULL)
+            .put("codec", if (transportStarted) video.diagnosticCodec ?: JSONObject.NULL else JSONObject.NULL)
+            .put("lastFrameAgeMs", if (hasFrames && lastFrame > 0L) (android.os.SystemClock.elapsedRealtime() - lastFrame).coerceAtLeast(0L) else JSONObject.NULL)
+            .put("audioSinks", if (transportStarted) JSONObject(component.audioDecoder.diagnosticSinks().mapKeys { it.key.toString() }) else JSONObject())
+    }
+}
